# =============================================================================
# .env.example — Plantilla de variables de entorno para Nelzzon.
#
# REGLAS:
#   - NUNCA pongas valores reales aquí. Este archivo se versiona en Git.
#   - Copia esto a .env (local) o configura las variables en el servidor.
#   - Los valores marcados como CHANGE_ME deben reemplazarse antes de usar.
#   - Genera secrets fuertes con: openssl rand -base64 64
#   - En producción: usa variables de entorno del servidor o un secret manager.
#     NUNCA subas .env con credenciales reales al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS — PostgreSQL 16
# app_admin: BYPASSRLS. Migraciones, resolución de identidad, ops cross-tenant.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://app_admin:CHANGE_ME@localhost:5432/nelzzon?schema=public"

# app_user: SIN bypass. Runtime tenant-scoped. RLS lo filtra todo.
RUNTIME_DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/nelzzon?schema=public"

# -----------------------------------------------------------------------------
# BETTER AUTH
# Genera el secret con: openssl rand -base64 64
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64"
BETTER_AUTH_URL="http://localhost:3000"

# Orígenes de confianza separados por coma. En producción: https://nelzzon.com,https://www.nelzzon.com
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# -----------------------------------------------------------------------------
# URL PÚBLICA DE LA APP
# En producción: https://nelzzon.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# ALMACENAMIENTO DE DOCUMENTOS (Cloudflare R2)
# DOCUMENT_STORAGE_DRIVER=r2 activa el almacenamiento real.
# Sin estas variables, la carga de documentos queda deshabilitada (fail-closed).
# -----------------------------------------------------------------------------
DOCUMENT_STORAGE_DRIVER="local"
R2_ACCOUNT_ID="CHANGE_ME"
R2_BUCKET_NAME="CHANGE_ME"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
